{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrornode.org/schemas/terminal-agent-assignment.schema.json",
  "title": "MIRRORNODE Terminal Agent Assignment Record",
  "description": "Proposal schema for recording phase-gated specialized terminal-agent work. Validation is evidence only and grants no authority.",
  "type": "object",
  "required": [
    "schema_version",
    "assignment_id",
    "agent_role",
    "repository",
    "branch",
    "head_sha",
    "phase",
    "mutation_posture",
    "requested_deliverable",
    "non_scope",
    "inspection_before_write",
    "authorized_files",
    "authorized_commands",
    "external_effects",
    "authority_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "v0.1.0"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "agent_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "working_directory": {
      "type": ["string", "null"]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_ref": {
      "type": ["string", "null"]
    },
    "phase": {
      "enum": [
        "BOOTSTRAP",
        "INSPECTION",
        "REPORT_PENDING_AUTHORIZATION",
        "IMPLEMENTATION_AUTHORIZED",
        "VERIFICATION",
        "HANDOFF_PENDING_DISPOSITION",
        "BLOCKED",
        "BLOCKED_PREMATURE_MUTATION"
      ]
    },
    "mutation_posture": {
      "enum": ["READ_ONLY", "SCOPED_WRITE", "NO_FURTHER_MUTATION"]
    },
    "requested_deliverable": {
      "type": "string",
      "minLength": 1
    },
    "non_scope": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "inspection_before_write": {
      "type": "boolean"
    },
    "inspection_report": {
      "type": ["object", "null"],
      "required": [
        "reported_at",
        "inspected_surfaces",
        "findings",
        "unknowns",
        "proposed_plan",
        "stop_conditions"
      ],
      "properties": {
        "reported_at": {"type": "string", "format": "date-time"},
        "inspected_surfaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "unknowns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "proposed_plan": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": ["object", "null"],
      "required": ["reference", "authorized_at", "authorized_by", "scope_digest"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"},
        "authorized_by": {"type": "string", "minLength": 1},
        "scope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "authorized_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "authorized_commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "external_effects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "premature_mutation": {
      "type": ["object", "null"],
      "required": ["detected_at", "changed_paths", "mutation_source", "preserved_in_place"],
      "properties": {
        "detected_at": {"type": "string", "format": "date-time"},
        "changed_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "mutation_source": {"type": "string", "minLength": 1},
        "preserved_in_place": {"const": true}
      },
      "additionalProperties": false
    },
    "authority_claim": {
      "const": "NONE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": ["BOOTSTRAP", "INSPECTION", "REPORT_PENDING_AUTHORIZATION"]
          }
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "mutation_posture": {"const": "READ_ONLY"},
          "authorized_files": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": ["IMPLEMENTATION_AUTHORIZED", "VERIFICATION"]
          }
        },
        "required": ["phase"]
      },
      "then": {
        "required": ["inspection_report", "authorization"],
        "properties": {
          "inspection_report": {"type": "object"},
          "authorization": {"type": "object"},
          "mutation_posture": {"const": "SCOPED_WRITE"},
          "authorized_files": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "BLOCKED_PREMATURE_MUTATION"}
        },
        "required": ["phase"]
      },
      "then": {
        "required": ["premature_mutation"],
        "properties": {
          "mutation_posture": {"const": "NO_FURTHER_MUTATION"},
          "premature_mutation": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "inspection_before_write": {"const": true},
          "phase": {
            "enum": ["REPORT_PENDING_AUTHORIZATION", "IMPLEMENTATION_AUTHORIZED", "VERIFICATION", "HANDOFF_PENDING_DISPOSITION"]
          }
        },
        "required": ["inspection_before_write", "phase"]
      },
      "then": {
        "required": ["inspection_report"],
        "properties": {
          "inspection_report": {"type": "object"}
        }
      }
    }
  ],
  "additionalProperties": false
}
