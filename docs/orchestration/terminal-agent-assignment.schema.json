{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrornode.org/schemas/terminal-agent-assignment.schema.json",
  "title": "MIRRORNODE Terminal Agent Assignment Record",
  "description": "Proposal schema for recording phase-gated specialized terminal-agent work. Validation is evidence only and grants no authority.",
  "type": "object",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "file_operation": {
      "enum": [
        "CREATE",
        "MODIFY",
        "DELETE",
        "MOVE",
        "RENAME",
        "RESTORE"
      ]
    },
    "file_scope_entry": {
      "type": "object",
      "required": [
        "path",
        "operation"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "operation": {
          "$ref": "#/$defs/file_operation"
        },
        "destination_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "MOVE",
                  "RENAME"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "destination_path"
            ],
            "properties": {
              "destination_path": {
                "$ref": "#/$defs/repo_path"
              }
            }
          },
          "else": {
            "properties": {
              "destination_path": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "file_scope_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_scope_entry"
      },
      "uniqueItems": true
    },
    "status_record_entry": {
      "type": "object",
      "description": "One structurally parsed entry of a `git status --porcelain=v1 -z` capture.",
      "required": [
        "xy",
        "path",
        "original_path"
      ],
      "properties": {
        "xy": {
          "type": "string",
          "pattern": "^[ MADRCU?!]{2}$"
        },
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "original_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "xy": {
                "pattern": "[RC]"
              }
            },
            "required": [
              "xy"
            ]
          },
          "then": {
            "required": [
              "original_path"
            ],
            "properties": {
              "original_path": {
                "$ref": "#/$defs/repo_path"
              }
            }
          },
          "else": {
            "properties": {
              "original_path": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "assignment_id",
    "agent_role",
    "repository",
    "branch",
    "head_sha",
    "phase",
    "mutation_posture",
    "requested_deliverable",
    "non_scope",
    "inspection_before_write",
    "bootstrap_provenance",
    "authorized_files",
    "authorized_commands",
    "external_effects",
    "authority_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "v0.2.0"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "agent_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "working_directory": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "enum": [
        "BOOTSTRAP",
        "INSPECTION",
        "REPORT_PENDING_AUTHORIZATION",
        "IMPLEMENTATION_AUTHORIZED",
        "VERIFICATION",
        "HANDOFF_PENDING_DISPOSITION",
        "BLOCKED",
        "BLOCKED_PREMATURE_MUTATION"
      ]
    },
    "mutation_posture": {
      "enum": [
        "READ_ONLY",
        "SCOPED_WRITE",
        "VERIFICATION_ARTIFACTS_ONLY",
        "NO_FURTHER_MUTATION"
      ]
    },
    "requested_deliverable": {
      "type": "string",
      "minLength": 1
    },
    "non_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "inspection_before_write": {
      "type": "boolean"
    },
    "bootstrap_provenance": {
      "type": "object",
      "description": "Phase 0 record of the checkout and instruction surface the assignment was bootstrapped from.",
      "required": [
        "recorded_at",
        "instruction_files",
        "worktree_clean",
        "preexisting_changes"
      ],
      "properties": {
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "instruction_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repo_path"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "worktree_clean": {
          "type": "boolean"
        },
        "preexisting_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status_record_entry"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "inspection_report": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reported_at",
        "inspected_surfaces",
        "findings",
        "unknowns",
        "proposed_plan",
        "stop_conditions",
        "proposed_files",
        "proposed_commands",
        "proposed_external_effects",
        "dependencies_migrations_credentials",
        "decision_required"
      ],
      "properties": {
        "reported_at": {
          "$ref": "#/$defs/timestamp"
        },
        "inspected_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_plan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "proposed_files": {
          "$ref": "#/$defs/file_scope_array"
        },
        "proposed_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "proposed_external_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies_migrations_credentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decision_required": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reference",
        "authorized_at",
        "authorized_by",
        "status",
        "valid_until",
        "superseded_by",
        "scope_digest",
        "report_binding_digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "$ref": "#/$defs/timestamp"
        },
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED",
            "SUPERSEDED"
          ]
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "report_binding_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUPERSEDED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "superseded_by": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "superseded_by": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "phase_transition": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "event",
                "recorded_at",
                "report_binding_digest"
              ],
              "properties": {
                "event": {
                  "const": "INSPECTION_REPORT_RECORDED"
                },
                "recorded_at": {
                  "$ref": "#/$defs/timestamp"
                },
                "report_binding_digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "event",
                "recorded_at",
                "report_binding_digest",
                "authorization_reference",
                "scope_digest"
              ],
              "properties": {
                "event": {
                  "const": "IMPLEMENTATION_AUTHORIZED"
                },
                "recorded_at": {
                  "$ref": "#/$defs/timestamp"
                },
                "authorization_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "scope_digest": {
                  "$ref": "#/$defs/digest"
                },
                "report_binding_digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "additionalProperties": false
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "authorized_files": {
      "$ref": "#/$defs/file_scope_array"
    },
    "authorized_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "external_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_scope": {
      "type": [
        "object",
        "null"
      ],
      "description": "Verification authority is limited to declared checks and explicitly bounded artifact paths. It never carries the implementation source allowlist.",
      "required": [
        "verified_at",
        "declared_checks",
        "artifact_paths"
      ],
      "properties": {
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        },
        "declared_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repo_path"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "handoff_report": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reported_at",
        "final_head_sha",
        "worktree_state",
        "changed_paths",
        "checks_run",
        "unresolved_findings",
        "external_mutations_performed",
        "next_disposition_required"
      ],
      "properties": {
        "reported_at": {
          "$ref": "#/$defs/timestamp"
        },
        "final_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_state": {
          "enum": [
            "CLEAN",
            "UNCOMMITTED_CHANGES_PRESERVED"
          ]
        },
        "changed_paths": {
          "$ref": "#/$defs/file_scope_array"
        },
        "checks_run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "result"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "SKIPPED"
                ]
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "unresolved_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "external_mutations_performed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "next_disposition_required": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "premature_mutation": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "detected_at",
        "changed_paths",
        "mutation_source",
        "worktree_status",
        "worktree_status_record",
        "status_capture_digest",
        "diff_evidence",
        "preserved_in_place"
      ],
      "properties": {
        "detected_at": {
          "$ref": "#/$defs/timestamp"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repo_path"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mutation_source": {
          "type": "string",
          "minLength": 1
        },
        "worktree_status": {
          "type": "string",
          "minLength": 1
        },
        "worktree_status_record": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status_record_entry"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status_capture_digest": {
          "$ref": "#/$defs/digest"
        },
        "diff_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "capture",
              "capture_sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repo_path"
              },
              "capture": {
                "type": "string",
                "minLength": 1
              },
              "capture_sha256": {
                "$ref": "#/$defs/digest"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "preserved_in_place": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "authority_claim": {
      "const": "NONE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "BOOTSTRAP",
              "INSPECTION",
              "REPORT_PENDING_AUTHORIZATION"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "mutation_posture": {
            "const": "READ_ONLY"
          },
          "authorization": {
            "type": "null"
          },
          "phase_transition": {
            "type": "null"
          },
          "verification_scope": {
            "type": "null"
          },
          "handoff_report": {
            "type": "null"
          },
          "authorized_files": {
            "maxItems": 0
          },
          "authorized_commands": {
            "maxItems": 0
          },
          "external_effects": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "IMPLEMENTATION_AUTHORIZED",
              "VERIFICATION"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "inspection_report",
          "authorization",
          "phase_transition"
        ],
        "properties": {
          "inspection_report": {
            "type": "object"
          },
          "authorization": {
            "type": "object"
          },
          "phase_transition": {
            "type": "object"
          },
          "authorized_files": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "IMPLEMENTATION_AUTHORIZED"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "mutation_posture": {
            "const": "SCOPED_WRITE"
          },
          "verification_scope": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "VERIFICATION"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "verification_scope"
        ],
        "properties": {
          "mutation_posture": {
            "const": "VERIFICATION_ARTIFACTS_ONLY"
          },
          "verification_scope": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "HANDOFF_PENDING_DISPOSITION",
              "BLOCKED",
              "BLOCKED_PREMATURE_MUTATION"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "mutation_posture": {
            "const": "NO_FURTHER_MUTATION"
          },
          "authorized_files": {
            "maxItems": 0
          },
          "authorized_commands": {
            "maxItems": 0
          },
          "external_effects": {
            "maxItems": 0
          },
          "verification_scope": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "HANDOFF_PENDING_DISPOSITION"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "handoff_report"
        ],
        "properties": {
          "handoff_report": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "BLOCKED_PREMATURE_MUTATION"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "premature_mutation"
        ],
        "properties": {
          "mutation_posture": {
            "const": "NO_FURTHER_MUTATION"
          },
          "premature_mutation": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inspection_before_write": {
            "const": true
          },
          "phase": {
            "enum": [
              "REPORT_PENDING_AUTHORIZATION",
              "IMPLEMENTATION_AUTHORIZED",
              "VERIFICATION",
              "HANDOFF_PENDING_DISPOSITION"
            ]
          }
        },
        "required": [
          "inspection_before_write",
          "phase"
        ]
      },
      "then": {
        "required": [
          "inspection_report"
        ],
        "properties": {
          "inspection_report": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "premature_mutation": {
            "type": "object"
          }
        },
        "required": [
          "premature_mutation"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "BLOCKED_PREMATURE_MUTATION"
          },
          "mutation_posture": {
            "const": "NO_FURTHER_MUTATION"
          },
          "authorized_files": {
            "maxItems": 0
          },
          "authorized_commands": {
            "maxItems": 0
          },
          "external_effects": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
