{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrornode.org/schemas/terminal-agent-assignment.schema.json",
  "title": "MIRRORNODE Terminal Agent Assignment Record",
  "description": "Proposal schema for recording phase-gated specialized terminal-agent work. Validation is evidence only and grants no authority.",
  "type": "object",
  "required": [
    "schema_version",
    "assignment_id",
    "agent_role",
    "repository",
    "branch",
    "head_sha",
    "phase",
    "mutation_posture",
    "requested_deliverable",
    "non_scope",
    "inspection_before_write",
    "authorized_files",
    "authorized_commands",
    "external_effects",
    "authority_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "v0.1.0"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "agent_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "working_directory": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "enum": [
        "BOOTSTRAP",
        "INSPECTION",
        "REPORT_PENDING_AUTHORIZATION",
        "IMPLEMENTATION_AUTHORIZED",
        "VERIFICATION",
        "HANDOFF_PENDING_DISPOSITION",
        "BLOCKED",
        "BLOCKED_PREMATURE_MUTATION"
      ]
    },
    "mutation_posture": {
      "enum": [
        "READ_ONLY",
        "SCOPED_WRITE",
        "NO_FURTHER_MUTATION"
      ]
    },
    "requested_deliverable": {
      "type": "string",
      "minLength": 1
    },
    "non_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "inspection_before_write": {
      "type": "boolean"
    },
    "inspection_report": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reported_at",
        "inspected_surfaces",
        "findings",
        "unknowns",
        "proposed_plan",
        "stop_conditions",
        "proposed_files",
        "proposed_commands",
        "proposed_external_effects",
        "dependencies_migrations_credentials",
        "decision_required"
      ],
      "properties": {
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "inspected_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_plan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "proposed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "proposed_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "proposed_external_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies_migrations_credentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decision_required": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reference",
        "authorized_at",
        "authorized_by",
        "scope_digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "phase_transition": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "event",
                "recorded_at",
                "inspection_report_digest"
              ],
              "properties": {
                "event": {
                  "const": "INSPECTION_REPORT_RECORDED"
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "inspection_report_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "event",
                "recorded_at",
                "inspection_report_digest",
                "authorization_reference",
                "scope_digest"
              ],
              "properties": {
                "event": {
                  "const": "IMPLEMENTATION_AUTHORIZED"
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "authorization_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "scope_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "inspection_report_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "authorized_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authorized_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "external_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "premature_mutation": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "detected_at",
        "changed_paths",
        "mutation_source",
        "worktree_status",
        "worktree_status_sha256",
        "diff_evidence",
        "preserved_in_place"
      ],
      "properties": {
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mutation_source": {
          "type": "string",
          "minLength": 1
        },
        "worktree_status": {
          "type": "string",
          "minLength": 1
        },
        "worktree_status_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "diff_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "capture",
              "capture_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "capture": {
                "type": "string",
                "minLength": 1
              },
              "capture_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "preserved_in_place": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "authority_claim": {
      "const": "NONE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "BOOTSTRAP",
              "INSPECTION",
              "REPORT_PENDING_AUTHORIZATION"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "mutation_posture": {
            "const": "READ_ONLY"
          },
          "authorization": {
            "type": "null"
          },
          "phase_transition": {
            "type": "null"
          },
          "authorized_files": {
            "maxItems": 0
          },
          "authorized_commands": {
            "maxItems": 0
          },
          "external_effects": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "IMPLEMENTATION_AUTHORIZED",
              "VERIFICATION"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "inspection_report",
          "authorization",
          "phase_transition"
        ],
        "properties": {
          "inspection_report": {
            "type": "object"
          },
          "authorization": {
            "type": "object"
          },
          "phase_transition": {
            "type": "object"
          },
          "mutation_posture": {
            "const": "SCOPED_WRITE"
          },
          "authorized_files": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "HANDOFF_PENDING_DISPOSITION",
              "BLOCKED",
              "BLOCKED_PREMATURE_MUTATION"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "mutation_posture": {
            "const": "NO_FURTHER_MUTATION"
          },
          "authorized_files": {
            "maxItems": 0
          },
          "authorized_commands": {
            "maxItems": 0
          },
          "external_effects": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "BLOCKED_PREMATURE_MUTATION"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "premature_mutation"
        ],
        "properties": {
          "mutation_posture": {
            "const": "NO_FURTHER_MUTATION"
          },
          "premature_mutation": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inspection_before_write": {
            "const": true
          },
          "phase": {
            "enum": [
              "REPORT_PENDING_AUTHORIZATION",
              "IMPLEMENTATION_AUTHORIZED",
              "VERIFICATION",
              "HANDOFF_PENDING_DISPOSITION"
            ]
          }
        },
        "required": [
          "inspection_before_write",
          "phase"
        ]
      },
      "then": {
        "required": [
          "inspection_report"
        ],
        "properties": {
          "inspection_report": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "premature_mutation": {
            "type": "object"
          }
        },
        "required": [
          "premature_mutation"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "BLOCKED_PREMATURE_MUTATION"
          },
          "mutation_posture": {
            "const": "NO_FURTHER_MUTATION"
          },
          "authorized_files": {
            "maxItems": 0
          },
          "authorized_commands": {
            "maxItems": 0
          },
          "external_effects": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

