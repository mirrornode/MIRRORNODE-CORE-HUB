{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirrornode://schemas/deliberation-graph/v0.1",
  "title": "Deliberation Graph v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deliberation_id", "work_id", "target_ref", "moves", "dissent_preserved", "authority_effect"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "deliberation_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["move_id", "actor", "move_type", "body", "confidence", "scope", "created_at"],
        "properties": {
          "move_id": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "move_type": {"enum": ["ASSERT", "CHALLENGE", "REVISE", "DEFER", "DISSENT", "EVIDENCE_REQUEST", "SYNTHESIS"]},
          "body": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "responds_to": {"type": ["string", "null"]},
          "defer_to": {"type": ["string", "null"]},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "allOf": [
          {
            "if": {"properties": {"move_type": {"const": "DEFER"}}, "required": ["move_type"]},
            "then": {"required": ["defer_to"]}
          }
        ]
      }
    },
    "dissent_preserved": {"type": "boolean"},
    "surviving_dissent_ids": {"type": "array", "items": {"type": "string"}},
    "deference_effect": {"const": "SYNTHESIS_ONLY"},
    "deference_counts_toward_quorum": {"const": false},
    "deference_satisfies_independence": {"const": false},
    "authority_effect": {"const": "NONE"}
  }
}
