{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirrornode://schemas/intersection-record/v0.1",
  "title": "Intersection Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intersection_id", "participants", "scope", "observations", "authority_effect", "reviewer_routing_effect", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "intersection_id": {"type": "string", "minLength": 1},
    "participants": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_ref", "repository_ref", "task_class", "policy_version", "visibility_class"],
      "properties": {
        "tenant_ref": {"type": "string", "minLength": 1},
        "repository_ref": {"type": ["string", "null"]},
        "ref_or_commit": {"type": ["string", "null"]},
        "task_class": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "visibility_class": {"type": "string", "minLength": 1},
        "retention_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "kind", "statement", "provenance", "confidence", "scope_binding"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["BLIND_SPOT_CATCH", "PERSUASIVE_EVIDENCE_MODE", "SEMANTIC_FRICTION", "PRODUCTIVE_PAIRING", "DEFERENCE_PATTERN", "CALIBRATION_DELTA", "UNRESOLVED_DISPUTE", "OPERATOR_PREFERENCE_TRACE", "CONSENSUS_FAILURE_TRACE"]},
          "statement": {"type": "string", "minLength": 1},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "scope_binding": {"type": "string", "minLength": 1},
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "non_independent_work_routing_hints": {"type": "array", "items": {"type": "string"}},
    "scrutiny_hints": {"type": "array", "items": {"type": "string"}},
    "synthesis_hints": {"type": "array", "items": {"type": "string"}},
    "reviewer_routing_effect": {"const": "FORBIDDEN"},
    "attester_routing_effect": {"const": "FORBIDDEN"},
    "authority_effect": {"const": "NONE"},
    "non_authority_taint": {"const": true},
    "forbidden_effects": {
      "type": "array",
      "items": {"enum": ["MERGE_RIGHTS", "SECRET_ACCESS", "EXECUTION_PRIVILEGE", "IRREVERSIBLE_ACTION_PRIVILEGE", "PERMISSION_EXPANSION", "AUTHORITY_CLASS_REDUCTION", "REVIEWER_SELECTION", "ATTESTER_SELECTION", "REVIEW_THRESHOLD_REDUCTION", "RISK_DOWNGRADE"]},
      "uniqueItems": true
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
