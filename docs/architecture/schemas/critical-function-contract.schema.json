{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrornode.example/schemas/critical-function-contract.schema.json",
  "title": "MIRRORNODE Critical Function Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "function_id",
    "function_version",
    "purpose",
    "criticality",
    "owner",
    "authority_ceiling",
    "input_contract",
    "output_contract",
    "tool_contract",
    "side_effect_contract",
    "evidence_contract",
    "failure_contract",
    "acceptance_suite",
    "provenance_requirements",
    "independence_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "function_id": {
      "type": "string",
      "pattern": "^mirrornode\\.[a-z0-9][a-z0-9_.-]*$"
    },
    "function_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "criticality": {
      "type": "string",
      "enum": [
        "NON_CRITICAL",
        "IMPORTANT",
        "CRITICAL"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "authority_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_sha256",
        "ceiling_label"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "ceiling_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_contract": {
      "$ref": "#/$defs/contract_component"
    },
    "output_contract": {
      "$ref": "#/$defs/contract_component"
    },
    "tool_contract": {
      "$ref": "#/$defs/contract_component"
    },
    "side_effect_contract": {
      "$ref": "#/$defs/contract_component"
    },
    "evidence_contract": {
      "$ref": "#/$defs/contract_component"
    },
    "failure_contract": {
      "$ref": "#/$defs/contract_component"
    },
    "acceptance_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_ref",
        "suite_version",
        "suite_sha256",
        "threshold"
      ],
      "properties": {
        "suite_ref": {
          "type": "string",
          "minLength": 1
        },
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "suite_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "threshold": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "contract_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  },
  "$comment": "Schema validity does not create authority, prove semantic quality, or establish substrate eligibility."
}
