{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/mim-v0.1.schema.json",
  "title": "MIRRORNODE Integration Manifest (MIM) v0.1",
  "description": "Machine-readable adapter declaration schema. Implements MICC v0.1. Status: Pre-canon draft under CG-0033 review. No authority effect until operator disposition.",
  "type": "object",
  "required": [
    "mim_version",
    "adapter_id",
    "adapter_name",
    "micc_version",
    "capability_family",
    "provider_name",
    "provider_version",
    "adapter_version",
    "maintained_by",
    "created_at",
    "updated_at",
    "capabilities",
    "scopes_required",
    "scopes_granted",
    "scope_ceiling",
    "credential_requirements",
    "health_check",
    "lifecycle_state"
  ],
  "additionalProperties": false,
  "properties": {
    "mim_version": {"type":"string","const":"0.1"},
    "adapter_id": {"type":"string","pattern":"^[a-z0-9-]+$"},
    "adapter_name": {"type":"string","minLength":1},
    "micc_version": {"type":"string","const":"0.1"},
    "capability_family": {
      "type":"string",
      "enum":["IDENTITY","CREDENTIAL","STATE","ARTIFACT","EXECUTION","TRANSPORT","EVIDENCE","METERING"]
    },
    "provider_name": {"type":"string","minLength":1},
    "provider_version": {"type":"string","minLength":1},
    "adapter_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "maintained_by": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"},
    "capabilities": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "required":["name","description","approval_class","input_schema_ref","output_schema_ref","side_effect_class","idempotency","retry_policy","timeout_seconds","conformance_test_ref"],
        "additionalProperties":false,
        "properties": {
          "name":{"type":"string","pattern":"^[a-z0-9_]+$"},
          "description":{"type":"string","minLength":1},
          "approval_class":{"type":"string","enum":["APPROVAL_NONE","APPROVAL_AUTOMATED","APPROVAL_OPERATOR","APPROVAL_COUNCIL"]},
          "input_schema_ref":{"type":"string","minLength":1},
          "output_schema_ref":{"type":"string","minLength":1},
          "side_effect_class":{"type":"string","enum":["READ_ONLY","STATE_CHANGE","EXTERNAL_EFFECT"]},
          "idempotency":{"type":"string","enum":["REQUIRED","SUPPORTED","NOT_APPLICABLE"]},
          "retry_policy":{"type":"string","enum":["NONE","SAFE_RETRY","IDEMPOTENCY_KEY_REQUIRED"]},
          "timeout_seconds":{"type":"integer","minimum":1},
          "conformance_test_ref":{"type":"string","minLength":1}
        }
      }
    },
    "scopes_required": {
      "type":"array",
      "uniqueItems":true,
      "items":{"type":"string","minLength":1}
    },
    "scopes_granted": {
      "type":"array",
      "uniqueItems":true,
      "items":{"type":"string","minLength":1}
    },
    "scope_ceiling": {
      "type":"string",
      "minLength":1,
      "description":"Maximum MIRRORNODE scope from the governed scope vocabulary. Must be comparable under that vocabulary; no free-text ordering inference is permitted."
    },
    "credential_requirements": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["name","kind","capabilities","environment","lifetime","revocable","required"],
        "additionalProperties":false,
        "properties": {
          "name": {
            "type":"string",
            "minLength":1,
            "description":"Non-sensitive requirement label only. Must not contain secret contents, bearer values, secret-store paths, or opaque bearer-capable credential identifiers."
          },
          "kind":{"type":"string","enum":["API_KEY","OAUTH_TOKEN","MTLS_CERT","MACHINE_IDENTITY","OTHER"]},
          "capabilities": {
            "type":"array",
            "minItems":1,
            "uniqueItems":true,
            "items":{"type":"string","pattern":"^[a-z0-9_]+$"},
            "description":"Declared capability names requiring this credential. Runtime/conformance validation must verify that every value resolves to a capability in this same MIM instance."
          },
          "environment":{"type":"string","enum":["PRODUCTION","STAGING","DEVELOPMENT","ALL"]},
          "lifetime":{"type":"string","enum":["SHORT_LIVED","LONG_LIVED","ROTATING","STATIC"]},
          "revocable":{"type":"boolean"},
          "required":{"type":"boolean"}
        }
      }
    },
    "health_check": {
      "type":"object",
      "required":["method","interval_seconds","timeout_seconds","healthy_criteria","degraded_criteria"],
      "additionalProperties":false,
      "properties": {
        "method":{"type":"string","enum":["HTTP_GET","RPC","INTERNAL"]},
        "endpoint":{"type":"string"},
        "interval_seconds":{"type":"integer","minimum":1},
        "timeout_seconds":{"type":"integer","minimum":1},
        "healthy_criteria":{"type":"string","minLength":1},
        "degraded_criteria":{"type":"string","minLength":1}
      }
    },
    "lifecycle_state": {
      "type":"string",
      "enum":["DECLARED","IMPLEMENTED","VERIFIED","AUTHORIZED","ACTIVE","DEGRADED","SUSPENDED","RETIRED"]
    },
    "known_limitations": {
      "type":"array",
      "items":{"type":"string"}
    },
    "provider_extensions": {
      "type":"object",
      "description":"Provider-specific metadata only. Must not redefine MICC semantics or contain credential contents, bearer references, secret-store paths, unrestricted provider response bodies, or sensitive internal topology outside an explicitly approved disclosure boundary.",
      "propertyNames":{"pattern":"^x_[a-z0-9]+_[a-z0-9_]+$"}
    },
    "notes": {"type":"array","items":{"type":"string"}}
  }
}
