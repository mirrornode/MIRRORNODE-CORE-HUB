{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/mim-v0.1.schema.json",
  "title": "MIRRORNODE Integration Manifest (MIM) v0.1",
  "description": "Machine-readable adapter declaration schema. Implements MICC v0.1. Status: Pre-canon draft under CG-0033 review. No authority effect until operator disposition.",
  "type": "object",
  "required": [
    "mim_version",
    "adapter_id",
    "adapter_name",
    "micc_version",
    "capability_family",
    "provider_name",
    "provider_version",
    "adapter_version",
    "maintained_by",
    "created_at",
    "updated_at",
    "capabilities",
    "scopes_required",
    "scopes_granted",
    "scope_ceiling",
    "credential_requirements",
    "health_check",
    "lifecycle_state"
  ],
  "additionalProperties": false,
  "properties": {
    "mim_version": {
      "type": "string",
      "const": "0.1",
      "description": "MIM schema version. Must be 0.1 for this schema."
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Globally unique adapter instance identifier. Immutable after AUTHORIZED state."
    },
    "adapter_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable adapter name."
    },
    "micc_version": {
      "type": "string",
      "const": "0.1",
      "description": "MICC version this adapter declares conformance against."
    },
    "capability_family": {
      "type": "string",
      "enum": ["IDENTITY", "CREDENTIAL", "STATE", "ARTIFACT", "EXECUTION", "TRANSPORT", "EVIDENCE", "METERING"],
      "description": "The single MICC primitive capability family this adapter implements."
    },
    "provider_name": {
      "type": "string",
      "minLength": 1,
      "description": "The external provider or system being wrapped."
    },
    "provider_version": {
      "type": "string",
      "minLength": 1,
      "description": "The provider API or SDK version targeted by this adapter."
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this adapter declaration."
    },
    "maintained_by": {
      "type": "string",
      "minLength": 1,
      "description": "Principal responsible for maintaining this adapter."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 UTC creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 UTC last-updated timestamp."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "description": "Named operations this adapter exposes.",
      "items": {
        "type": "object",
        "required": ["name", "description", "approval_class"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "approval_class": {
            "type": "string",
            "enum": ["APPROVAL_NONE", "APPROVAL_AUTOMATED", "APPROVAL_OPERATOR", "APPROVAL_COUNCIL"]
          }
        }
      }
    },
    "scopes_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Provider-side access scopes this adapter requires."
    },
    "scopes_granted": {
      "type": "array",
      "items": { "type": "string" },
      "description": "MIRRORNODE-side scopes this adapter is permitted to exercise."
    },
    "scope_ceiling": {
      "type": "string",
      "minLength": 1,
      "description": "Maximum scope level this adapter may ever request."
    },
    "credential_requirements": {
      "type": "array",
      "description": "Credential requirements declared without credential contents.",
      "items": {
        "type": "object",
        "required": ["name", "kind", "scope", "environment", "lifetime", "revocable", "required"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["API_KEY", "OAUTH_TOKEN", "MTLS_CERT", "MACHINE_IDENTITY", "OTHER"]
          },
          "scope": { "type": "string", "minLength": 1 },
          "environment": {
            "type": "string",
            "enum": ["PRODUCTION", "STAGING", "DEVELOPMENT", "ALL"]
          },
          "lifetime": {
            "type": "string",
            "enum": ["SHORT_LIVED", "LONG_LIVED", "ROTATING", "STATIC"]
          },
          "revocable": { "type": "boolean" },
          "required": { "type": "boolean" }
        }
      }
    },
    "health_check": {
      "type": "object",
      "required": ["method", "interval_seconds", "timeout_seconds", "healthy_criteria", "degraded_criteria"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["HTTP_GET", "RPC", "INTERNAL"]
        },
        "endpoint": { "type": "string" },
        "interval_seconds": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "healthy_criteria": { "type": "string", "minLength": 1 },
        "degraded_criteria": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["DECLARED", "IMPLEMENTED", "VERIFIED", "AUTHORIZED", "ACTIVE", "DEGRADED", "SUSPENDED", "RETIRED"],
      "description": "Current lifecycle state per MICC Section 10."
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional. Known limitations of this adapter relative to the full MICC capability family semantics."
    },
    "provider_extensions": {
      "type": "object",
      "description": "Optional. Provider-specific extension fields. Must be namespaced x_<provider>_<field>. May not redefine MICC-normative fields.",
      "propertyNames": {
        "pattern": "^x_[a-z0-9]+_[a-z0-9_]+$"
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional. Human-readable notes about this adapter declaration."
    }
  }
}
