{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrornode.local/schemas/agent-card.schema.json",
  "title": "MIRRORNODE Agent Or Service Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "kind",
    "status",
    "lane",
    "evidence_class",
    "capabilities",
    "service_areas",
    "allowed_actions",
    "blocked_actions",
    "requires_review_for",
    "handoff_outputs",
    "authority_boundary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["agent", "service", "provider_adapter", "execution_surface"]
    },
    "status": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "evidence_class": {
      "type": "string",
      "enum": ["confirmed", "partial_evidence", "unknown", "contradicted"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "service_areas": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "blocked_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requires_review_for": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "handoff_outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "authority_boundary": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
