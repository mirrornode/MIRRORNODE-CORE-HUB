{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/decision-preconditions-v0.1.schema.json",
  "title": "MIRRORNODE Decision Preconditions v0.1",
  "description": "Deterministic precondition evaluation. Combiner is ALL_MUST_PASS. Unsupported or unresolvable combinations fail closed. No open expression language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preconditions_id",
    "preconditions_version",
    "combiner",
    "checks"
  ],
  "properties": {
    "preconditions_id": {
      "$ref": "#/definitions/stableId"
    },
    "preconditions_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "combiner": {
      "const": "ALL_MUST_PASS"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "kind",
          "operator",
          "target",
          "expected"
        ],
        "properties": {
          "check_id": {
            "$ref": "#/definitions/stableId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "STATE_HASH",
              "RESOURCE_VERSION",
              "DEPENDENCY_STATE",
              "TIME_WINDOW",
              "IDEMPOTENCY_KEY"
            ],
            "description": "Supported kinds with closed deterministic semantics:\n- STATE_HASH: target is a stable path or the literal 'state_hash'; observed value is the current authenticated state hash (sha256:...); operators EQUALS | NOT_EQUALS; expected is string matching sha256 pattern; comparison is exact string equality after normalization of the observed hash; failure or unresolvable observed value fails closed.\n- RESOURCE_VERSION: target is a canonical resource URI or registry path; observed value is the version/identity string or integer from the bound resource-registry record. String values support EQUALS | NOT_EQUALS only and compare by exact code-point sequence. Integer values support EQUALS | NOT_EQUALS | AT_LEAST | AT_MOST and compare numerically. Ordered comparison of string versions is unsupported and fails schema validation.\n- DEPENDENCY_STATE: target is a dependency identifier; observed value is the current state token of that dependency; operators EQUALS | NOT_EQUALS | UNSEEN. EQUALS/NOT_EQUALS require a string expected token. UNSEEN requires expected=true and succeeds only when no prior observation of the target exists. Any unresolvable observation fails closed.\n- TIME_WINDOW: target is a clock identifier (usually 'evaluation_time' or 'wall_clock'); observed value is ISO-8601 UTC timestamp; operators AT_LEAST | AT_MOST; expected is ISO-8601 UTC string; comparison is chronological; out-of-window or unparseable fails closed.\n- IDEMPOTENCY_KEY: target is an authoritative idempotency namespace/key path. EQUALS requires a string expected key and succeeds only when the authoritative store records exactly that key for the target. UNSEEN requires expected=true and succeeds only when the authoritative store has no record for the target. Integers, false for UNSEEN, coercion, and all other operator/value combinations are schema-invalid and fail closed."
          },
          "operator": {
            "type": "string",
            "enum": [
              "EQUALS",
              "NOT_EQUALS",
              "AT_LEAST",
              "AT_MOST",
              "UNSEEN"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": [
              "string",
              "integer",
              "boolean"
            ],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "evidence_ref": {
            "$ref": "#/definitions/repoRef"
          },
          "evidence_hash": {
            "$ref": "#/definitions/sha256"
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "dependencies": {
          "evidence_ref": [
            "evidence_hash"
          ],
          "evidence_hash": [
            "evidence_ref"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "STATE_HASH"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "operator": {
                  "enum": [
                    "EQUALS",
                    "NOT_EQUALS"
                  ]
                },
                "expected": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "RESOURCE_VERSION"
                },
                "expected": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "expected"
              ]
            },
            "then": {
              "properties": {
                "operator": {
                  "enum": [
                    "EQUALS",
                    "NOT_EQUALS"
                  ]
                },
                "expected": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "RESOURCE_VERSION"
                },
                "expected": {
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "expected"
              ]
            },
            "then": {
              "properties": {
                "operator": {
                  "enum": [
                    "EQUALS",
                    "NOT_EQUALS",
                    "AT_LEAST",
                    "AT_MOST"
                  ]
                },
                "expected": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "DEPENDENCY_STATE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "operator": {
                  "enum": [
                    "EQUALS",
                    "NOT_EQUALS",
                    "UNSEEN"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "TIME_WINDOW"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "operator": {
                  "enum": [
                    "AT_LEAST",
                    "AT_MOST"
                  ]
                },
                "expected": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "IDEMPOTENCY_KEY"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "operator": {
                  "enum": [
                    "EQUALS",
                    "UNSEEN"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "RESOURCE_VERSION"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "DEPENDENCY_STATE"
                },
                "operator": {
                  "const": "UNSEEN"
                }
              },
              "required": [
                "kind",
                "operator"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "DEPENDENCY_STATE"
                },
                "operator": {
                  "enum": [
                    "EQUALS",
                    "NOT_EQUALS"
                  ]
                }
              },
              "required": [
                "kind",
                "operator"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "IDEMPOTENCY_KEY"
                },
                "operator": {
                  "const": "EQUALS"
                }
              },
              "required": [
                "kind",
                "operator"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "IDEMPOTENCY_KEY"
                },
                "operator": {
                  "const": "UNSEEN"
                }
              },
              "required": [
                "kind",
                "operator"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "repoRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
