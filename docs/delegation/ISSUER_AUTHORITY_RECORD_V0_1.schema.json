{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/issuer-authority-record-v0.1.schema.json",
  "title": "MIRRORNODE Delegation Issuer Authority Record v0.1",
  "description": "Hash-bound root-authority record proving a logical issuer may delegate a stated scope. Authentication of a credential is not this authorization. The record MUST be governed outside the grantee's control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_version",
    "logical_issuer_id",
    "allowed_operations",
    "resource_scope",
    "environment_scope",
    "authority_rank",
    "authority_ceiling",
    "risk_ceiling",
    "subdelegation_max_depth",
    "effective_at",
    "expires_at"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "record_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "logical_issuer_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9:_-]+$"}},
    "resource_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"}},
    "environment_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["DEVELOPMENT", "STAGING", "PRODUCTION", "LOCAL"]}},
    "authority_rank": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "authority_ceiling": {"type": "string", "minLength": 1},
    "risk_ceiling": {"type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "subdelegation_max_depth": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "effective_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}
