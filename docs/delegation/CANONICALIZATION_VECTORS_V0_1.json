{
  "$comment": "Normative RFC 8785 / SHA-256 fixtures for CG-0036. Object names ordered by UTF-16 code units. Set-like arrays are sorted before hashing.",
  "profile": "CANONICALIZATION_V0_1",
  "algorithm": "RFC8785",
  "hash": "SHA-256",
  "hash_prefix": "sha256:",
  "name_order": "utf-16-code-units",
  "vectors": [
    {
      "id": "canon-basic",
      "description": "Canonical input with nested object and preserved array order.",
      "input": {
        "b": 2,
        "a": "alpha",
        "arr": [
          "x",
          "y"
        ],
        "nested": {
          "z": true,
          "m": false
        }
      },
      "canonical": "{\"a\":\"alpha\",\"arr\":[\"x\",\"y\"],\"b\":2,\"nested\":{\"m\":false,\"z\":true}}",
      "sha256": "sha256:82409b46fb0375fe1fcb07f116e4ab1f57939650441cad995913527b8184b0f1",
      "expected_result": "match"
    },
    {
      "id": "canon-key-order",
      "description": "BMP key-order variation MUST match canon-basic.",
      "input": {
        "arr": [
          "x",
          "y"
        ],
        "nested": {
          "m": false,
          "z": true
        },
        "a": "alpha",
        "b": 2
      },
      "canonical": "{\"a\":\"alpha\",\"arr\":[\"x\",\"y\"],\"b\":2,\"nested\":{\"m\":false,\"z\":true}}",
      "sha256": "sha256:82409b46fb0375fe1fcb07f116e4ab1f57939650441cad995913527b8184b0f1",
      "expected_result": "match"
    },
    {
      "id": "canon-string-variation",
      "description": "Material string variation MUST produce a different SHA-256.",
      "input": {
        "b": 2,
        "a": "Alpha",
        "arr": [
          "x",
          "y"
        ],
        "nested": {
          "z": true,
          "m": false
        }
      },
      "differs_from": "canon-basic",
      "expected_result": "different_hash",
      "canonical": "{\"a\":\"Alpha\",\"arr\":[\"x\",\"y\"],\"b\":2,\"nested\":{\"m\":false,\"z\":true}}",
      "sha256": "sha256:e044bbcc47759e44337b3c801ee04ee6b31036dea82476bb431d3f2553cbaf89"
    },
    {
      "id": "canon-utf16-name-order",
      "description": "Non-BMP U+1D11E vs BMP U+FFFD: UTF-16 code-unit order differs from Unicode code-point order.",
      "input": {
        "�": 1,
        "𝄞": 2
      },
      "canonical": "{\"𝄞\":2,\"�\":1}",
      "sha256": "sha256:2e6e702a81fa4a31456bcc7ef6fd4b495c753890f058726fcb654e805d686ee0",
      "code_point_order_canonical": "{\"�\":1,\"𝄞\":2}",
      "expected_result": "match",
      "must_differ_from_code_point_order": true
    },
    {
      "id": "canon-duplicate-key",
      "description": "Duplicate object keys MUST be rejected before canonicalization.",
      "raw_json": "{\"a\":1,\"a\":2}",
      "expected_result": "reject_duplicate_keys"
    },
    {
      "id": "canon-non-ijson-nan",
      "description": "Non-I-JSON NaN MUST be rejected.",
      "raw_json": "{\"n\":NaN}",
      "expected_result": "reject_non_ijson"
    },
    {
      "id": "canon-ijson-max-int",
      "description": "Largest IEEE-754 binary64 exact integer MUST accept.",
      "input": {
        "n": 9007199254740991
      },
      "canonical": "{\"n\":9007199254740991}",
      "sha256": "sha256:e1da48c6a6089f06ecb4e0a2259e658e3786b2420f52baccdf929ec6460d7b41",
      "expected_result": "match"
    },
    {
      "id": "canon-ijson-min-int",
      "description": "Smallest IEEE-754 binary64 exact integer MUST accept.",
      "input": {
        "n": -9007199254740991
      },
      "canonical": "{\"n\":-9007199254740991}",
      "sha256": "sha256:d49d713821fc149f81ef6ca8054beeba696f5da052f0ab3e2d773808c5a9d625",
      "expected_result": "match"
    },
    {
      "id": "canon-ijson-oversize-positive",
      "description": "2^53 MUST be rejected; not rounded or stringified.",
      "input": {
        "n": 9007199254740992
      },
      "expected_result": "reject_non_ijson_integer"
    },
    {
      "id": "canon-ijson-oversize-negative",
      "description": "-2^53 MUST be rejected; not rounded or stringified.",
      "input": {
        "n": -9007199254740992
      },
      "expected_result": "reject_non_ijson_integer"
    },
    {
      "id": "canon-ijson-oversize-nested",
      "description": "Oversized nested integer MUST be rejected.",
      "input": {
        "wrap": {
          "n": 9007199254740992
        }
      },
      "expected_result": "reject_non_ijson_integer"
    },
    {
      "id": "canon-ijson-oversize-array",
      "description": "Oversized array member MUST be rejected.",
      "input": {
        "arr": [
          1,
          9007199254740992
        ]
      },
      "expected_result": "reject_non_ijson_integer"
    },
