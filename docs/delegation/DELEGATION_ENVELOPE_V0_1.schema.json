{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/delegation-envelope-v0.1.schema.json",
  "title": "MIRRORNODE Delegation Envelope v0.1",
  "description": "Draft machine-readable delegation envelope under CG-0036. No implementation or canon authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delegation_id",
    "delegation_version",
    "delegator",
    "issuer_proof",
    "delegate_actor",
    "authority_class",
    "governing_policy_ref",
    "policy_version",
    "policy_content_hash",
    "policy_bundle_hash",
    "allowed_operations",
    "resource_scope",
    "environment_scope",
    "authority_ceiling",
    "authority_rank",
    "risk_ceiling",
    "decision_preconditions_ref",
    "decision_preconditions_hash",
    "issued_at",
    "effective_at",
    "expires_at",
    "revocation_behavior",
    "expiry_behavior",
    "max_revocation_propagation_seconds",
    "receipt_policy_ref",
    "subdelegation"
  ],
  "properties": {
    "delegation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "delegation_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "delegator": {"type": "string", "minLength": 1},
    "issuer_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_type", "issuer_credential_ref", "signed_payload_hash"],
      "properties": {
        "proof_type": {"type": "string", "enum": ["DIGITAL_SIGNATURE", "TRUSTED_REGISTRY_ATTESTATION", "HARDWARE_BACKED_ASSERTION"]},
        "issuer_credential_ref": {"type": "string", "minLength": 1},
        "signed_payload_hash": {"$ref": "#/definitions/sha256"},
        "proof_value": {"type": "string", "minLength": 16},
        "proof_ref": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["proof_value"], "not": {"required": ["proof_ref"]}},
        {"required": ["proof_ref"], "not": {"required": ["proof_value"]}}
      ]
    },
    "delegate_actor": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "enum": ["AUTONOMOUS_WITHIN_POLICY", "ADVISORY_ONLY", "OPERATOR_APPROVAL_REQUIRED", "NON_DELEGABLE"]},
    "governing_policy_ref": {"$ref": "#/definitions/repoRef"},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_content_hash": {"$ref": "#/definitions/sha256"},
    "policy_bundle_hash": {"$ref": "#/definitions/sha256"},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9:_-]+$"}},
    "resource_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/canonicalResource"}},
    "environment_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["DEVELOPMENT", "STAGING", "PRODUCTION", "LOCAL"]}},
    "authority_ceiling": {"type": "string", "minLength": 1},
    "authority_rank": {"type": "integer", "minimum": 0},
    "risk_ceiling": {"type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "decision_preconditions_ref": {"$ref": "#/definitions/repoRef"},
    "decision_preconditions_hash": {"$ref": "#/definitions/sha256"},
    "issued_at": {"$ref": "#/definitions/utcTimestamp"},
    "effective_at": {"$ref": "#/definitions/utcTimestamp"},
    "expires_at": {"$ref": "#/definitions/utcTimestamp"},
    "revocation_behavior": {"type": "string", "enum": ["CANCEL_ON_REVOCATION", "COMPLETE_CURRENT_ATOMIC_STEP", "COMPLETE_CURRENT_TRANSACTION", "NON_INTERRUPTIBLE_WITH_EXPLICIT_RATIONALE"]},
    "non_interruptible_rationale": {"type": "string", "minLength": 20, "pattern": "^(?=.*\\S).{20,}$"},
    "expiry_behavior": {"type": "string", "enum": ["CANCEL_ON_EXPIRY", "COMPLETE_CURRENT_ATOMIC_STEP", "COMPLETE_CURRENT_TRANSACTION", "ALLOW_COMPLETION_IF_DECISION_WAS_VALID_AND_BOUND"]},
    "max_revocation_propagation_seconds": {"type": "integer", "minimum": 0},
    "revocation_ref": {"$ref": "#/definitions/repoRef"},
    "receipt_policy_ref": {"$ref": "#/definitions/repoRef"},
    "aggregate_authority_policy_ref": {"$ref": "#/definitions/repoRef"},
    "subdelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {"type": "boolean"},
        "max_depth": {"type": "integer", "minimum": 0},
        "eligible_operations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9:_-]+$"}},
        "parent_delegation_ref": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}
      },
      "allOf": [
        {"if": {"properties": {"allowed": {"const": true}}, "required": ["allowed"]}, "then": {"required": ["max_depth", "eligible_operations"]}}
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"revocation_behavior": {"const": "NON_INTERRUPTIBLE_WITH_EXPLICIT_RATIONALE"}}, "required": ["revocation_behavior"]},
      "then": {"required": ["non_interruptible_rationale"]}
    }
  ],
  "definitions": {
    "repoRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "canonicalResource": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"}
  }
}
