{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/resource-registry-snapshot-v0.1.schema.json",
  "title": "MIRRORNODE Resource Registry Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "snapshot_version", "logical_issuer_id", "issuer_registry_ref", "issuer_registry_snapshot_hash", "issuer_proof", "issued_at", "records"],
  "properties": {
    "snapshot_id": {"$ref": "#/definitions/stableId"},
    "snapshot_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "logical_issuer_id": {"$ref": "#/definitions/stableId"},
    "issuer_registry_ref": {"$ref": "#/definitions/repoRef"},
    "issuer_registry_snapshot_hash": {"$ref": "#/definitions/sha256"},
    "issuer_proof": {"$ref": "#/definitions/issuerProof"},
    "issued_at": {"$ref": "#/definitions/utcTimestamp"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["canonical_uri", "resource_type", "provider", "native_target_id", "environment", "record_hash"], "properties": {"canonical_uri": {"$ref": "#/definitions/canonicalResource"}, "resource_type": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "native_target_id": {"type": "string", "minLength": 1}, "environment": {"type": "string", "enum": ["DEVELOPMENT", "STAGING", "PRODUCTION", "LOCAL"]}, "identity_anchors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "record_hash": {"$ref": "#/definitions/sha256"}}}}
  },
  "definitions": {
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "repoRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "canonicalResource": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"},
    "issuerProof": {"type": "object", "additionalProperties": false, "required": ["proof_type", "issuer_credential_ref", "signed_payload_hash"], "properties": {"proof_type": {"type": "string", "enum": ["DIGITAL_SIGNATURE", "TRUSTED_REGISTRY_ATTESTATION", "HARDWARE_BACKED_ASSERTION"]}, "issuer_credential_ref": {"type": "string", "minLength": 1}, "signed_payload_hash": {"$ref": "#/definitions/sha256"}, "proof_value": {"type": "string", "minLength": 16}, "proof_ref": {"type": "string", "minLength": 1}}, "oneOf": [{"required": ["proof_value"], "not": {"required": ["proof_ref"]}}, {"required": ["proof_ref"], "not": {"required": ["proof_value"]}}]}
  }
}
