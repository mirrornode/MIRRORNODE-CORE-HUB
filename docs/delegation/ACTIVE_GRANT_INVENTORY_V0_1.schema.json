{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/active-grant-inventory-v0.1.schema.json",
  "title": "MIRRORNODE Active Grant Inventory v0.1",
  "description": "Authenticated authoritative inventory of every delegation candidate active for one authority holder at one evaluation instant. The payload hash is RFC 8785 over the complete object excluding issuer_proof. active_delegation_payload_hashes MUST be sorted ascending by lowercase hexadecimal digest bytes and MUST contain the complete registry result for the subject and evaluation_time; omission, duplication, stale sequence, or unverifiable completeness fails closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory_id",
    "inventory_version",
    "authority_holder_logical_issuer_id",
    "evaluation_time",
    "registry_sequence",
    "active_delegation_payload_hashes",
    "query_semantics",
    "logical_issuer_id",
    "issuer_registry_ref",
    "issuer_registry_snapshot_hash",
    "issuer_proof"
  ],
  "properties": {
    "inventory_id": {"$ref": "#/definitions/stableId"},
    "inventory_version": {"const": "0.1.0"},
    "authority_holder_logical_issuer_id": {"$ref": "#/definitions/stableId"},
    "evaluation_time": {"$ref": "#/definitions/utcTimestamp"},
    "registry_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "active_delegation_payload_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/sha256"}
    },
    "query_semantics": {"const": "ALL_ACTIVE_DELEGATIONS_FOR_AUTHORITY_HOLDER_AT_EVALUATION_TIME"},
    "logical_issuer_id": {"$ref": "#/definitions/stableId"},
    "issuer_registry_ref": {"$ref": "#/definitions/repoRef"},
    "issuer_registry_snapshot_hash": {"$ref": "#/definitions/sha256"},
    "issuer_proof": {"$ref": "#/definitions/issuerProof"}
  },
  "definitions": {
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "repoRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"},
    "issuerProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_type", "issuer_credential_ref", "signed_payload_hash"],
      "properties": {
        "proof_type": {"type": "string", "enum": ["DIGITAL_SIGNATURE", "TRUSTED_REGISTRY_ATTESTATION", "HARDWARE_BACKED_ASSERTION"]},
        "issuer_credential_ref": {"type": "string", "minLength": 1},
        "signed_payload_hash": {"$ref": "#/definitions/sha256"},
        "proof_value": {"type": "string", "minLength": 16},
        "proof_ref": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["proof_value"], "not": {"required": ["proof_ref"]}},
        {"required": ["proof_ref"], "not": {"required": ["proof_value"]}}
      ]
    }
  }
}
