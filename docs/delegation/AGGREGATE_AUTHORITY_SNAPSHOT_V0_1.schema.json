{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/aggregate-authority-snapshot-v0.1.schema.json",
  "title": "MIRRORNODE Aggregate Authority Snapshot v0.1",
  "description": "Closed snapshot hashed into DELEGATION_DECISION_V0_1.aggregate_authority_snapshot_hash using RFC 8785 per CANONICALIZATION_V0_1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "snapshot_version",
    "subject",
    "evaluation_time",
    "applicable_delegation_payload_hashes",
    "root_ceiling_ref",
    "root_ceiling_hash",
    "forbid_policy_ref",
    "forbid_policy_hash",
    "resource_scope",
    "environment_scope",
    "cumulative_risk",
    "cumulative_budget",
    "cumulative_cardinality",
    "effective_authority_digest",
    "evaluator_identity",
    "evaluator_version"
  ],
  "properties": {
    "snapshot_id": {"$ref": "#/definitions/stableId"},
    "snapshot_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "subject": {"$ref": "#/definitions/typedEntity"},
    "evaluation_time": {"$ref": "#/definitions/utcTimestamp"},
    "applicable_delegation_payload_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/sha256"}
    },
    "root_ceiling_ref": {"$ref": "#/definitions/repoRef"},
    "root_ceiling_hash": {"$ref": "#/definitions/sha256"},
    "forbid_policy_ref": {"$ref": "#/definitions/repoRef"},
    "forbid_policy_hash": {"$ref": "#/definitions/sha256"},
    "resource_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/canonicalResource"}
    },
    "environment_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["DEVELOPMENT", "STAGING", "PRODUCTION", "LOCAL"]}
    },
    "cumulative_risk": {"type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "cumulative_budget": {"type": "integer", "minimum": 0},
    "cumulative_cardinality": {"type": "integer", "minimum": 0},
    "effective_authority_digest": {"$ref": "#/definitions/sha256"},
    "evaluator_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "definitions": {
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "repoRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"},
    "canonicalResource": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"},
    "typedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    }
  }
}
