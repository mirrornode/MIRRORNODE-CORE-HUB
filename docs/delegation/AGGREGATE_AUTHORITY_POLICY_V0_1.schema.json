{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirrornode.github.io/schemas/aggregate-authority-policy-v0.1.schema.json",
  "title": "MIRRORNODE Aggregate Authority Policy v0.1",
  "description": "Closed parameters for deterministic CG0036_AGGREGATE_V0_1 evaluation. Scope is intersection-only; authority/risk are most-restrictive maxima; budget is the checked sum of authenticated per-grant budget_ceiling values; cardinality is the count of distinct canonical resources in the aggregate union before request intersection; forbidden sets are evaluated over the union of active allowed-operation sets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "policy_version", "algorithm", "scope_combiner", "grant_combiner", "risk_order", "budget_unit", "max_authority_rank", "max_cumulative_risk", "max_cumulative_budget", "max_cumulative_cardinality", "max_distinct_delegations"],
  "properties": {
    "policy_id": {"$ref": "#/definitions/stableId"},
    "policy_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "algorithm": {"const": "CG0036_AGGREGATE_V0_1"},
    "scope_combiner": {"const": "INTERSECTION_ONLY"},
    "grant_combiner": {"const": "MOST_RESTRICTIVE"},
    "risk_order": {"const": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "budget_unit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9:_-]+$"},
    "max_authority_rank": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_cumulative_risk": {"type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "max_cumulative_budget": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_cumulative_cardinality": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_distinct_delegations": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "forbidden_operation_sets": {"type": "array", "items": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9:_-]+$"}}}
  },
  "definitions": {"stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}}
}
